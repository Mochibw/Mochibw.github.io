# Generated website and extension builds (at any depth)
dist/
/.astro/
*.tsbuildinfo

# Installed dependencies (website and local VS Code extension)
node_modules/

# Logs and test output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vscode-test/
coverage/

# Local environment values; keep shareable examples
.env
.env.*
!.env.example
!.env.*.example

# OS and personal IDE files
.DS_Store
Thumbs.db
Desktop.ini
.idea/

# Derived article-tag index; shared .vscode configs remain tracked
/.vscode/article-tags.json
/.vscode/article-tags.json.tmp

# Locally packaged extension; keep its source, tests, docs and lockfile
/tools/article-tags-vscode/*.vsix
