---
interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;
const tagHref = href || `/tags/${tag}/`;
---

<a
  href={tagHref}
  class="inline-flex items-center rounded-full border border-slate-200/80 bg-slate-100/80 px-2.5 py-0.5 text-xs font-medium text-slate-600 hover:border-cyan-200 hover:bg-cyan-50 hover:text-[var(--color-text-link)] transition-colors duration-200"
>
  {tag}
</a>
