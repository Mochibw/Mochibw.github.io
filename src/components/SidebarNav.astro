---
import { siteConfig } from '../config/site';
import { isActivePath, navigationCurrent } from '../lib/navigation';

const path = Astro.url.pathname;
const icons = {
  home: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  thoughts: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  learning: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  about: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
};
---

<nav class="space-y-2" aria-label="主要导航">
  <h4 class="text-sm font-semibold text-slate-700 mb-3">导航</h4>
  {siteConfig.navigation.map(item => (
    <a
      href={item.href}
      aria-current={navigationCurrent(path, item.href)}
      class:list={[
        'flex items-center space-x-3 py-2 px-3 rounded-lg transition-colors duration-200',
        isActivePath(path, item.href)
          ? 'bg-cyan-50 text-[var(--color-text-link)] font-medium'
          : 'text-slate-600 hover:text-[var(--color-text-link)] hover:bg-gray-50',
      ]}
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[item.icon]} />
      </svg>
      <span class="text-sm">{item.label}</span>
    </a>
  ))}
</nav>
