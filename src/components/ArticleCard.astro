---
import type { CollectionEntry } from 'astro:content';
import TagPill from './TagPill.astro';

interface Props {
  entry: CollectionEntry<'thoughts' | 'learning'>;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};
---

<article class="article-entry grid min-w-0 gap-2 py-6 first:pt-0 last:pb-0 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-6">
  <time class="text-xs text-slate-500 leading-7 sm:text-sm" datetime={entry.data.pubDate.toISOString()}>
    {formatDate(entry.data.pubDate)}
  </time>
  <div class="min-w-0 [overflow-wrap:anywhere]">
    <Heading class="text-xl font-semibold text-slate-800 leading-snug">
      <a
        href={`/${entry.collection}/${entry.slug}/`}
        class="hover:text-[var(--color-text-link)] hover:underline underline-offset-4 transition-colors duration-200"
      >
        {entry.data.title}
      </a>
    </Heading>
    <p class="mt-2 text-sm text-slate-600 leading-relaxed sm:text-base">
      {entry.data.description}
    </p>
    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {entry.data.tags.map((tag) => (
          <TagPill tag={tag} />
        ))}
      </div>
    )}
  </div>
</article>
