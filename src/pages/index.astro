---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { sortArticles } from '../lib/content';

// 获取最新的想法和学习笔记
const thoughts = await getCollection('thoughts');
const learning = await getCollection('learning');

// 按日期排序并取最新的3篇
const latestThoughts = sortArticles(thoughts).slice(0, 3);
const latestLearning = sortArticles(learning).slice(0, 3);
---

<Layout>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <section class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">
        {siteConfig.homeTitle}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
        {siteConfig.homeDescription}
      </p>
    </section>

    <section class="mb-12" aria-labelledby="thoughts-heading">
      <div class="flex justify-between items-center gap-4 mb-6">
        <h2 id="thoughts-heading" class="text-2xl font-semibold text-slate-800">想法</h2>
        <a
          href="/thoughts/"
          class="shrink-0 text-sm text-[var(--color-text-link)] hover:text-[var(--color-text-link-hover)] transition-colors duration-200"
          aria-label="查看全部想法"
        >
          查看全部 →
        </a>
      </div>

      {latestThoughts.length > 0 ? (
        <div class="divide-y divide-slate-200/80">
          {latestThoughts.map((entry) => (
            <ArticleCard entry={entry} headingLevel="h3" />
          ))}
        </div>
      ) : (
        <p class="text-sm text-slate-500">还没有想法文章，敬请期待...</p>
      )}
    </section>

    {latestLearning.length > 0 ? (
      <section aria-labelledby="learning-heading">
        <div class="flex justify-between items-center gap-4 mb-6">
          <h2 id="learning-heading" class="text-2xl font-semibold text-slate-800">学习</h2>
          <a
            href="/learning/"
            class="shrink-0 text-sm text-[var(--color-text-link)] hover:text-[var(--color-text-link-hover)] transition-colors duration-200"
            aria-label="查看全部学习笔记"
          >
            查看全部 →
          </a>
        </div>
        <div class="divide-y divide-slate-200/80">
          {latestLearning.map((entry) => (
            <ArticleCard entry={entry} headingLevel="h3" />
          ))}
        </div>
      </section>
    ) : (
      <section class="flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between" aria-labelledby="learning-heading">
        <div>
          <h2 id="learning-heading" class="text-base font-semibold text-slate-700">学习</h2>
          <p class="mt-1 text-sm text-slate-500">笔记整理中，写好就放在这里。</p>
        </div>
        <a href="/learning/" class="shrink-0 text-sm text-[var(--color-text-link)] hover:text-[var(--color-text-link-hover)] transition-colors duration-200">
          查看栏目 →
        </a>
      </section>
    )}
  </div>
</Layout>
