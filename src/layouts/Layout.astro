---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!DOCTYPE html>
<html lang="zh-CN" data-sidebar-collapsed="false" data-mobile-menu-open="false" data-sidebar-initializing>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Restore desktop preference before paint; navigation also works when storage is blocked.
      (function() {
        try {
          document.documentElement.dataset.sidebarCollapsed = String(localStorage.getItem('sidebarCollapsed') === 'true');
        } catch { /* Keep the expanded default. */ }
      })();
    </script>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col">
    <Sidebar />

    <div id="main-content" class="min-w-0 flex flex-col min-h-screen">
      <Header />

      <main class="flex-1 overflow-y-auto pb-8">
        <div class="page-transition">
          <slot />
        </div>
      </main>

      <Footer />
    </div>

    <script>
      import '../scripts/sidebar';
    </script>
  </body>
</html>
